{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "summary", "category", "tags", "rating"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "type": {"enum": ["local", "external"]},
    "path": {"type": "string", "maxLength": 200},
    "source": {"type": "string", "description": "GitHub owner/repo (external only)", "maxLength": 100},
    "ref": {"type": "string", "description": "external only", "maxLength": 40},
    "skill": {"type": "string", "description": "external only", "maxLength": 100},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "category": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score"],
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 5},
        "quality": {"type": "integer", "minimum": 1, "maximum": 5},
        "usefulness": {"type": "integer", "minimum": 1, "maximum": 5},
        "maturity": {"type": "integer", "minimum": 1, "maximum": 5},
        "reviewed": {"type": ["string", "null"]}
      }
    },
    "template": {"type": "boolean", "description": "local only. true = must be filled in / adapted per project before use"},
    "derived_from": {
      "type": "object",
      "description": "local only. local skills adapted from someone else's work: credit and licence",
      "additionalProperties": false,
      "required": ["source", "path", "license"],
      "properties": {"source": {"type": "string"}, "path": {"type": "string"}, "license": {"type": "string"}}
    },
    "notes": {"type": "string", "description": "our own review commentary; never the upstream skill text"}
  }
}
